        <mxCell id="1 r15" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R5 Apply once&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R5&quot;&lt;br&gt;text = &quot;A Volunteer applies once per opportunity. Closed, past or full opportunities refuse with a reason.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath scoping, D8&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: ApplicationController.apply()&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC2, SC4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
