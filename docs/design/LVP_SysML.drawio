        <mxCell id="1 r27" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;NFR1 Restart resilience&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;NFR1&quot;&lt;br&gt;text = &quot;The application is available and fully functional after its host restarts, without code or configuration changes, including when the host's network address changes.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = OLA Q&amp;A 3 Nov 2026, FAQ 0.6&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: WebServer (nginx), APIServer (PM2 startup)&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC6" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
