        <mxCell id="1 r7" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R1 Two enforced roles&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R1&quot;&lt;br&gt;text = &quot;Two roles are enforced by the server. Registration creates Volunteers only. Organisers are seeded.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath scoping, D1&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: AuthMiddleware, AuthController&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC3" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="220" height="300" as="geometry" />
        </mxCell>
        <mxCell id="1 r8" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 r3" target="1 r7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1 r9" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R2 Create opportunity&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R2&quot;&lt;br&gt;text = &quot;An Organiser creates an opportunity: title 3 to 100 chars, description up to 1,000, location, future event date, close date on or before the event, capacity 1 to 100.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath scoping, D10&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: OpportunityController.create()&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="280" y="400" width="220" height="300" as="geometry" />
        </mxCell>
        <mxCell id="1 r10" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 r3" target="1 r9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1 r11" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R3 Edit and close&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R3&quot;&lt;br&gt;text = &quot;An Organiser edits or closes their own opportunity. It closes automatically at its close date. Capacity cannot drop below the approved count.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath review, D7, D9&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: OpportunityController.update(), close()&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="400" width="220" height="300" as="geometry" />
        </mxCell>
        <mxCell id="1 r12" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=none;startArrow=circlePlus;startFill=0;startSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 r3" target="1 r11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1 r13" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R4 Browse open opportunities&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R4&quot;&lt;br&gt;text = &quot;A Volunteer browses open, future opportunities with the places remaining.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath scoping&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: OpportunityController.listOpen(), Browse page&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
