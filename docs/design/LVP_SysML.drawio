        <mxCell id="1 r17" value="&lt;div style=&quot;text-align:center&quot;&gt;«requirement»&lt;br&gt;&lt;b&gt;R6 Decide within capacity&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id = &quot;R6&quot;&lt;br&gt;text = &quot;An Organiser approves or rejects Pending applications. Approvals never exceed capacity.&quot;&lt;br&gt;priority = Must&lt;br&gt;source = Sath scoping&lt;hr&gt;&lt;i&gt;satisfiedBy&lt;/i&gt;: ApplicationController.decide()&lt;br&gt;&lt;i&gt;verifiedBy&lt;/i&gt;: SC1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
